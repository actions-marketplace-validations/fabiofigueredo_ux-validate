    "dictionary-en": "^4.0.0",
    "dictionary-es": "^4.0.0",
    "dictionary-pt": "^4.0.0",
    "hunspell-asm": "^4.0.2",
    "playwright": "~1.64.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  }
}
