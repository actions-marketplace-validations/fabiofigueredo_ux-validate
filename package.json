{
  "name": "ux-validate",
  "version": "0.5.0",
  "description": "Persona-based testing of web app content, navigation, interface and accessibility, run by your AI agent. English and Portuguese.",
  "author": "Fabio Figueredo (https://github.com/fabiofigueredo)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabiofigueredo/ux-validate.git"
  },
  "homepage": "https://github.com/fabiofigueredo/ux-validate#readme",
  "bugs": {
    "url": "https://github.com/fabiofigueredo/ux-validate/issues"
  },
  "type": "module",
  "bin": {
    "ux-validate": "bin/ux-validate.js"
  },
  "files": [
    "bin",
    "src",
    "source"
